{#- The pages of the app: the "lab" template of Voila, plus MathJax for the formulas (the lab template of Voila 0.5
    removes it, so $...$ stayed as raw text). Selected by app_config/voila.json. MathJax (SVG output: one file, no fonts to fetch) is served by the app itself
    (static/, works without network), the CDN is the fallback. -#}
{%- extends 'lab/index.html.j2' -%}
{%- block html_head_js_mathjax -%}
<script>
window.MathJax = {
  tex: {inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']], processEscapes: true},
  options: {skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']},
  startup: {
    ready: () => {
      MathJax.startup.defaultReady();
      // cells and widgets (questions, feedback) arrive after the page: typeset each new piece of the page
      let pending = null;
      new MutationObserver((records) => {
        if (records.every(r => r.target.closest && r.target.closest('mjx-container'))) return;
        clearTimeout(pending);
        pending = setTimeout(() => MathJax.typesetPromise().catch(() => {}), 300);
      }).observe(document.body, {childList: true, subtree: true, characterData: true});
    }
  }
};
</script>
<script async src="{{ resources.base_url }}voila/templates/twin/static/tex-svg-full.js"
        onerror="var s = document.createElement('script'); s.async = true; s.src = 'https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-svg-full.js'; document.head.appendChild(s);"></script>
{#- the look of the app (fonts, colors, buttons, questions): static/twin.css -#}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
{#- ?v=...: a new address at each page, so that a browser (the app's above all) never keeps an old twin.css: the server
    sends it without a cache rule, and the app went on showing the old look after a change -#}
<link rel="stylesheet" href="{{ resources.base_url }}voila/templates/twin/static/twin.css?v={{ range(1, 1000000000) | random }}">
{#- the online version (pages opened from the start page, "?sid=..."): a bar at the top to go back to the missions,
    as the tabs of the app. In the app (no sid) nothing changes. -#}
<script>
document.addEventListener("DOMContentLoaded", function () {
  if (!/[?&]sid=/.test(window.location.search)) return;
  var bar = document.createElement("div");
  bar.className = "twin-webbar";
  var back = document.createElement("a");
  back.href = "{{ resources.base_url }}";
  back.target = "twin-catalogue";
  back.textContent = "← Missions";
  back.title = "Back to the list of missions (this page stays open in its tab)";
  var name = document.createElement("span");
  name.textContent = "ESS digital twins";
  bar.appendChild(back); bar.appendChild(name);
  document.body.insertBefore(bar, document.body.firstChild);
});
</script>
{%- endblock html_head_js_mathjax -%}
