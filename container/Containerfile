# Container image of the ACCESS digital twins: McStas + official ESS instrument models (ODIN, LoKI) + twins + NICOS
# + JupyterLab.
# Built and tested by GitHub Actions (.github/workflows/container.yml); also builds with Docker or Podman:
#   docker build -f container/Containerfile -t access-twins .
#   docker run --rm -p 8888:8888 -v twin-data:/data access-twins
# Linux base with micromamba (conda-forge); runs as the unprivileged user "mambauser".
FROM mambaorg/micromamba:1.5.10

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates openssh-client curl \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data && chown "$MAMBA_USER:$MAMBA_USER" /data
USER $MAMBA_USER

# Conda environments (pinned versions): "mcstas" for the twins, "nicos" for NICOS (numpy < 2)
COPY --chown=$MAMBA_USER:$MAMBA_USER container/environment-mcstas.yml container/environment-nicos.yml /tmp/
RUN micromamba create -y -f /tmp/environment-mcstas.yml \
 && micromamba create -y -f /tmp/environment-nicos.yml \
 && micromamba clean -a -y

# The entry point of the base image activates this environment; RUN steps too
ENV ENV_NAME=mcstas
ARG MAMBA_DOCKERFILE_ACTIVATE=1

# Official McStas model of ODIN (ESS/DMSC), fixed commit
ARG ODIN_REPO=https://git.esss.dk/dmsc-instrumentmodels/odin.git
ARG ODIN_COMMIT=ea4fc94e7f961beb9a51564078c966db8db794f0
RUN git clone --quiet "$ODIN_REPO" "$HOME/odin_model" \
 && git -C "$HOME/odin_model" checkout --quiet "$ODIN_COMMIT" \
 && pip install --no-deps -e "$HOME/odin_model/instrpy" -e "$HOME/odin_model/extra"

# Official McStas model of LoKI (ESS/DMSC), fixed commit. Its upstream part is precomputed (release asset, see
# fetch_fronts.py): the model is only needed to recompute it or to read the instrument description.
ARG LOKI_REPO_URL=https://git.esss.dk/dmsc-instrumentmodels/LOKI.git
ARG LOKI_COMMIT=00fc29c76df3087648b1f133c549e981ef3084c3
RUN git clone --quiet "$LOKI_REPO_URL" "$HOME/loki_model" \
 && git -C "$HOME/loki_model" checkout --quiet "$LOKI_COMMIT"

# NICOS sources, fixed commit; a shallow checkout has no version tag, so the version is written by hand
ARG NICOS_COMMIT=44bec9c74fea00406a936ae327b2fd71253e3138
ARG NICOS_VERSION=3.13.2.dev0+g44bec9c
RUN git init --quiet "$HOME/nicos_src" \
 && cd "$HOME/nicos_src" \
 && git fetch --quiet --depth 1 https://github.com/mlz-ictrl/nicos "$NICOS_COMMIT" \
 && git checkout --quiet FETCH_HEAD \
 && echo "$NICOS_VERSION" > nicos/RELEASE-VERSION \
 && micromamba run -n nicos pip install --no-cache-dir -r requirements.txt pyqtgraph "h5py<3.15" https://github.com/ess-dmsc/yuos_query/releases/download/v0.1.21/yuos_query-0.1.21-py3-none-any.whl

# Live data, as at ESS (start_nicos.py --live): Kafka broker (Apache Kafka 3.9, KRaft mode, Java 21 in the conda
# environment "kafka", archive checked against its SHA-512), just-bin-it (ESS histogrammer, fixed commit, run from its
# sources) and the ESS streaming libraries in the twin and NICOS environments.
ARG KAFKA_VERSION=3.9.1
ARG KAFKA_SHA512=1EA204BA73411737A275429CA976D440F007FF0957B90B19BE41DC5A4BAE52617267769BE9F0B5791714D0B3C4C760605BD426FAEA39EDD90763585523FA2CFE
ARG JBI_COMMIT=fe32c7e
RUN micromamba create -y -n kafka -c conda-forge "openjdk=21" && micromamba clean -a -y \
 && curl -sSL -o /tmp/kafka.tgz "https://archive.apache.org/dist/kafka/${KAFKA_VERSION}/kafka_2.13-${KAFKA_VERSION}.tgz" \
 && echo "${KAFKA_SHA512}  /tmp/kafka.tgz" | tr 'A-F' 'a-f' | sha512sum -c - \
 && tar xzf /tmp/kafka.tgz -C "$HOME" && rm /tmp/kafka.tgz \
 && git clone --quiet https://github.com/ess-dmsc/just-bin-it.git "$HOME/just-bin-it" \
 && git -C "$HOME/just-bin-it" checkout --quiet "$JBI_COMMIT" \
 && pip install --no-cache-dir "confluent-kafka>=2.14,<3" "ess-streaming-data-types>=0.27,<0.28" "graphyte>=1.7.1,<2" \
        "ConfigArgParse>=1.7.5,<2" \
 && micromamba run -n nicos pip install --no-cache-dir "confluent-kafka>=2.1" "ess-streaming-data-types>=0.21" \
        "keyring>=10.6" "keyrings.alt>=4.0" "pycryptodomex>=3.4.7"

# Real ODIN file used as template for the NeXus files (downloaded by essimaging; kept in the image)
RUN python -c "import ess.odin.data as d; print(d.iron_simulation_ob_small())"

# The twins (this repository)
COPY --chown=$MAMBA_USER:$MAMBA_USER . /home/mambauser/twin
WORKDIR /home/mambauser/twin

ENV TWIN_RUN_ROOT=/data/twin \
    LOKI_REPO=/home/mambauser/loki_model \
    KAFKA_HOME=/home/mambauser/kafka_2.13-3.9.1 \
    JBI_HOME=/home/mambauser/just-bin-it \
    NICOS_ROOT=/home/mambauser/nicos_src \
    CONDA_ROOT=/opt/conda \
    OMPI_MCA_rmaps_base_oversubscribe=1 \
    OMPI_MCA_btl_vader_single_copy_mechanism=none
VOLUME /data
EXPOSE 8888 8866 8765 1301

ENTRYPOINT ["/usr/local/bin/_entrypoint.sh", "bash", "/home/mambauser/twin/container/start.sh"]
CMD ["jupyter"]
