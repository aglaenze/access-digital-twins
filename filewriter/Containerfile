# The ESS file-writer (kafka-to-nexus, ECDC), built from its sources: step 1 of filewriter/README.md.
# Built by GitHub Actions (.github/workflows/filewriter.yml); the image is ghcr.io/aglaenze/access-digital-twins-filewriter.
#   docker build -f filewriter/Containerfile -t filewriter .
#   docker run --rm filewriter kafka-to-nexus --help
# The version of kafka-to-nexus is the ref K2N_REF (a tag or a commit of github.com/ess-dmsc/kafka-to-nexus, the
# mirror of gitlab.esss.lu.se/ecdc/ess-dmsc/kafka-to-nexus).
FROM ubuntu:22.04 AS build
ARG K2N_REF=main
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ninja-build python3-pip pkg-config curl ca-certificates perl autoconf automake libtool doxygen graphviz \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir "conan<2" "cmake>=3.26,<4"
# Conan 1 with the configuration of ECDC (remotes, profiles: linux_x86_64_gcc11 = the gcc 11 of Ubuntu 22.04)
RUN conan config install https://github.com/ess-dmsc/conan-configuration.git
RUN git clone https://github.com/ess-dmsc/kafka-to-nexus.git /src && cd /src && git checkout "$K2N_REF" \
    && git log -1 --format="kafka-to-nexus %H %cd" | tee /K2N_VERSION
WORKDIR /src
RUN conan install . -if=build/Release -s build_type=Release --build=missing --profile=linux_x86_64_gcc11
RUN cmake --preset=release && cmake --build --preset=release --target kafka-to-nexus
# the program and the shared libraries it needs, in one folder
# (the libraries: as the built program finds them, in the build tree and in the Conan cache, e.g. libcrypt.so.2)
RUN K2N="$(find build/Release -type f -name kafka-to-nexus -perm -u+x | head -1)" \
    && mkdir -p /dist/bin /dist/lib && cp "$K2N" /dist/bin/ \
    && find build/Release -name '*.so*' \( -type f -o -type l \) -exec cp -a {} /dist/lib/ \; \
    && find /root/.conan/data -path '*/package/*/lib/*.so*' \( -type f -o -type l \) -exec cp -a {} /dist/lib/ \; \
    && ldd "$K2N" | awk '/=> \// {print $3}' | grep -v -E '^/lib|^/usr/lib' | xargs -r -I{} cp -L {} /dist/lib/ \
    && cp /K2N_VERSION /dist/
# a library still not found (e.g. libcrypt.so.2): looked for in the whole build image, and copied
RUN for pass in 1 2 3; do \
      for n in $(LD_LIBRARY_PATH=/dist/lib ldd /dist/bin/kafka-to-nexus /dist/lib/*.so* 2>/dev/null \
                 | awk '/not found/ {print $1}' | sort -u); do \
        f="$(find / -xdev -name "$n" \( -type f -o -type l \) -not -path '/dist/*' 2>/dev/null | head -1)"; \
        echo "missing $n: found at '$f'"; [ -n "$f" ] && cp -L "$f" /dist/lib/; \
      done; \
    done; true
# every library found (otherwise the build stops here)
RUN if LD_LIBRARY_PATH=/dist/lib ldd /dist/bin/kafka-to-nexus | grep "not found"; then \
      find / -xdev -name 'libcrypt*' -not -path '/proc/*' 2>/dev/null; exit 1; fi

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /dist /opt/kafka-to-nexus
ENV PATH="/opt/kafka-to-nexus/bin:${PATH}" LD_LIBRARY_PATH="/opt/kafka-to-nexus/lib"
CMD ["kafka-to-nexus", "--help"]
